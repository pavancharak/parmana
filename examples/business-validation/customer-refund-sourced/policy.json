{
  "policyId": "customer-refund-sourced",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Example (not bound to paytm:refund). Authorizes a customer refund only with a signed manager approval for that order and amount. Whether the order is eligible and whether the payment passed fraud assessment are asked of the systems that own those facts (the order system and the fraud system), never declared by the caller. The amount limit matches customer-refund 1.2.0.",
  "signalsSchema": {
    "managerApproved": "boolean",
    "refundAmount": "number",
    "refundEligible": "boolean",
    "fraudCheckPassed": "boolean"
  },
  "boundSignals": {
    "refundAmount": "parameters.amount"
  },
  "signalSources": {
    "refundEligible": {
      "source": "order-system",
      "claim": "refund.eligible",
      "subject": "parameters.orderId",
      "maxAgeSeconds": 60
    },
    "fraudCheckPassed": {
      "source": "fraud-system",
      "claim": "payment.fraud-check-passed",
      "subject": "parameters.orderId",
      "maxAgeSeconds": 300
    }
  },
  "approvalSignals": {
    "managerApproved": {
      "resourceId": "parameters.orderId",
      "value": "parameters.amount"
    }
  },
  "rules": [
    {
      "id": "reject-fraud-check",
      "condition": {
        "fact": "fraudCheckPassed",
        "operator": "is_false"
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the fraud system reports the payment did not pass fraud assessment."
      }
    },
    {
      "id": "reject-not-eligible",
      "condition": {
        "fact": "refundEligible",
        "operator": "is_false"
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the order system reports the order is not eligible for a refund."
      }
    },
    {
      "id": "reject-invalid-amount",
      "condition": {
        "fact": "refundAmount",
        "operator": "lte",
        "value": 0
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the refund amount must be greater than 0."
      }
    },
    {
      "id": "reject-above-maximum",
      "condition": {
        "fact": "refundAmount",
        "operator": "gt",
        "value": 100000
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected because the requested refund amount exceeds the maximum of 100000, even with a manager approval."
      }
    },
    {
      "id": "approve-refund-with-manager-approval",
      "condition": {
        "all": [
          {
            "fact": "managerApproved",
            "operator": "is_true"
          },
          {
            "fact": "refundEligible",
            "operator": "is_true"
          },
          {
            "fact": "fraudCheckPassed",
            "operator": "is_true"
          },
          {
            "fact": "refundAmount",
            "operator": "gt",
            "value": 0
          },
          {
            "fact": "refundAmount",
            "operator": "lte",
            "value": 100000
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Refund authorized: a signed manager approval for this order and amount, and the order and fraud systems confirm it."
      }
    },
    {
      "id": "reject-manager-approval-required",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Refund rejected. Every refund needs a signed manager approval for this order, covering this amount, and the order and fraud systems confirming it."
      }
    }
  ]
}
